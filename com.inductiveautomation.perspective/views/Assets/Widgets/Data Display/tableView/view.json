              "transforms": [
                {
                  "code": "\tpath \u003d self.view.params.tagPath\n\t\n\tresults \u003d system.tag.browse(path)\n\t\n\tarray \u003d []\n\t\n\tfor i in range(len(results)):\n\t\ttry:\n\t\t\trow \u003d {\n\t\t\t\t\"name\": \"\",\n\t\t\t\t\"tooltip\": \"\",\n\t\t\t\t\"value\": \"\"\n\t\t\t}\n\t\t\t\n\t\t\ttag_data \u003d system.tag.readBlocking([\n\t\t\t\tstr(results[i][\"fullPath\"]) + \".Tooltip\",\t\t\t\t# Tag 0\n\t\t\t\tstr(results[i][\"fullPath\"]) + \".EngUnit\",\t\t\t\t# Tag 1\n\t\t\t\tstr(results[i][\"fullPath\"]) + \".value\"\t\t\t\t\t# Tag 2\n\t\t\t])\n\t\t\t\n\t\t\teu \u003d tag_data[1].value\n\t\t\tvalue \u003d tag_data[2].value\n\t\t\t\n\t\t\trow[\"name\"] \u003d results[i][\"name\"]\n\t\t\trow[\"tooltip\"] \u003d tag_data[0].value\n\t\t\ttemp_value \u003d str(results[i][\"value\"]).replace(\"[\", \"\").replace(\"]\", \"\").split(\",\")[0]\n\t\t\t\n\t\t\t\n\t\t\t# Check for quality\n\t\t\tquality \u003d str(system.tag.readBlocking([str(results[i][\"fullPath\"])])[0].quality)\n\t\t\trow[\"value\"] \u003d (\"{0} {1}\".format(temp_value, eu)) if quality \u003d\u003d \"Good\" else \"Not Available\"\n\t\t\t\n\t\t\tarray.append(row)\n\t\texcept:\n\t\t\tprint (\"Error parsing object!\")\n\t\n\treturn array",
                  "type": "script"
                }
              ],
              "type": "expr"
            }

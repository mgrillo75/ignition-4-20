              },
              "scope": "C",
              "type": "popup"
            }
          }
        },
        "meta": {
          "name": "Breaker",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "height": 30,
          "rotate": {
            "anchor": "50% 39%"
          },
          "width": 30,
          "y": 20
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {

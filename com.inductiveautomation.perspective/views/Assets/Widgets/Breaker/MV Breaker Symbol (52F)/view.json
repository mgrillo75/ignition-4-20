{
  "custom": {},
  "params": {
    "color": "#D5D5D5",
    "label": "52F",
    "tagPathBreaker52F": "[default]TX3/tx3-pb1-n1-fcb1-751-001"
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPathBreaker52F": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 50
    }
  },
  "root": {
    "children": [
      {
        "events": {

                {
                  "fallback": "{[default]_Settings/Colors/Background}",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": 1,
                      "output": "{[default]_Settings/Colors/Energized}"
                    },
                    {
                      "input": 0,
                      "output": "{[default]_Settings/Colors/Deenergized}"
                    }
                  ],
                  "outputType": "expression",
                  "type": "map"
                }
              ],
              "type": "expr"
            }
          },
          "props.textStyle.color": {
            "binding": {
              "config": {
                "expression": "tag({view.params.tagPathBreaker52F}+\"/bit_52a\")"
              },
              "transforms": [
                {
                  "fallback": "{[default]_Settings/Colors/Background}",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "{[default]_Settings/Colors/Energized}"
                    },
                    {
                      "input": false,
                      "output": "{[default]_Settings/Colors/Deenergized}"

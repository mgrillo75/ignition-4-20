              "transforms": [
                {
                  "fallback": "",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": false,
                      "output": ""
                    },
                    {
                      "input": true,
                      "output": "Theme/Dark_FontWhite"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "expr"
            }

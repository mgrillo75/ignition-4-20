      {
        "meta": {
          "hasDelegate": true,
          "name": "DateTime"
        },
        "position": {
          "basis": "210px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{[System]Gateway/CurrentDateTime}"
              },
              "transforms": [
                {
                  "formatType": "datetime",
                  "formatValue": {
                    "date": "medium",
                    "time": "medium"
                  },
                  "type": "format"
                }
              ],
              "type": "expr"
            }
          },
          "props.textStyle.classes": {
            "binding": {
              "config": {
                "expression": "if({session.props.theme}!\u003d\"light\",true, false)"

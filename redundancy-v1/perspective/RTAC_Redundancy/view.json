{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 540,
      "width": 880
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "title"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": "22px",
            "fontWeight": "bold",
            "color": "#222",
            "paddingBottom": "8px"
          },
          "text": "RTAC Redundancy — Live Status"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "healthRow"
        },
        "position": {
          "basis": "160px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "style": {
            "gap": "16px"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "cardA"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "expression": "if({[default]GCS_RTAC_Control/ActiveRTAC} = \"A\",\r\n  if({[default]GCS_RTAC_Control/A_Healthy}, \"#E7F6EC\", \"#FCE8E6\"),\r\n  if({[default]GCS_RTAC_Control/A_Healthy}, \"#F5F7FA\", \"#FCE8E6\"))"
                  },
                  "type": "expr"
                }
              },
              "props.style.borderColor": {
                "binding": {
                  "config": {
                    "expression": "if({[default]GCS_RTAC_Control/ActiveRTAC} = \"A\",\r\n  if({[default]GCS_RTAC_Control/A_Healthy}, \"#2E7D32\", \"#C62828\"),\r\n  if({[default]GCS_RTAC_Control/A_Healthy}, \"#B0BEC5\", \"#C62828\"))"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "direction": "column",
              "style": {
                "borderStyle": "solid",
                "borderWidth": "3px",
                "borderRadius": "8px",
                "padding": "16px",
                "gap": "6px"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "titleA"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "fontSize": "16px",
                    "fontWeight": "bold",
                    "color": "#333"
                  },
                  "text": "GCSA_RTAC_MODBUS"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "statusA"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({[default]GCS_RTAC_Control/A_Healthy}, \"Connected\", \"Disconnected\")"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.color": {
                    "binding": {
                      "config": {
                        "expression": "if({[default]GCS_RTAC_Control/A_Healthy}, \"#2E7D32\", \"#C62828\")"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "18px",
                    "fontWeight": "bold"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "roleA"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({[default]GCS_RTAC_Control/ActiveRTAC} = \"A\", \"Role: ACTIVE\", \"Role: standby\")"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "14px",
                    "color": "#555"
                  }
                },
                "type": "ia.display.label"
              }
            ]
          },
          {
            "meta": {
              "name": "cardB"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "expression": "if({[default]GCS_RTAC_Control/ActiveRTAC} = \"B\",\r\n  if({[default]GCS_RTAC_Control/B_Healthy}, \"#E7F6EC\", \"#FCE8E6\"),\r\n  if({[default]GCS_RTAC_Control/B_Healthy}, \"#F5F7FA\", \"#FCE8E6\"))"
                  },
                  "type": "expr"
                }
              },
              "props.style.borderColor": {
                "binding": {
                  "config": {
                    "expression": "if({[default]GCS_RTAC_Control/ActiveRTAC} = \"B\",\r\n  if({[default]GCS_RTAC_Control/B_Healthy}, \"#2E7D32\", \"#C62828\"),\r\n  if({[default]GCS_RTAC_Control/B_Healthy}, \"#B0BEC5\", \"#C62828\"))"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "direction": "column",
              "style": {
                "borderStyle": "solid",
                "borderWidth": "3px",
                "borderRadius": "8px",
                "padding": "16px",
                "gap": "6px"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "titleB"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "fontSize": "16px",
                    "fontWeight": "bold",
                    "color": "#333"
                  },
                  "text": "GCSB_RTAC_MODBUS"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "statusB"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({[default]GCS_RTAC_Control/B_Healthy}, \"Connected\", \"Disconnected\")"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.color": {
                    "binding": {
                      "config": {
                        "expression": "if({[default]GCS_RTAC_Control/B_Healthy}, \"#2E7D32\", \"#C62828\")"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "18px",
                    "fontWeight": "bold"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "roleB"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({[default]GCS_RTAC_Control/ActiveRTAC} = \"B\", \"Role: ACTIVE\", \"Role: standby\")"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "14px",
                    "color": "#555"
                  }
                },
                "type": "ia.display.label"
              }
            ]
          }
        ]
      },
      {
        "meta": {
          "name": "controlRow"
        },
        "position": {
          "basis": "90px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "16px",
            "paddingTop": "16px",
            "alignItems": "flex-end"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "forcedLabel"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "style": {
                "fontSize": "14px",
                "fontWeight": "bold",
                "paddingBottom": "6px"
              },
              "text": "Operator override (ForcedRTAC):"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "forcedDropdown"
            },
            "position": {
              "basis": "200px",
              "shrink": 0
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "tagPath": "[default]GCS_RTAC_Control/ForcedRTAC"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "options": [
                { "value": "AUTO", "label": "AUTO (follow MasterController)" },
                { "value": "A",    "label": "Force A (GCSA)" },
                { "value": "B",    "label": "Force B (GCSB)" }
              ]
            },
            "type": "ia.input.dropdown"
          },
          {
            "meta": {
              "name": "currentActive"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Currently routing to: \" + {[default]SEL_Internal_Tags/ActiveProvider}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "15px",
                "fontWeight": "bold",
                "color": "#1565C0",
                "textAlign": "right",
                "paddingBottom": "6px"
              }
            },
            "type": "ia.display.label"
          }
        ]
      },
      {
        "meta": {
          "name": "auditRow"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "16px",
            "paddingTop": "16px"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "auditCount"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "borderStyle": "solid",
                "borderWidth": "1px",
                "borderColor": "#CFD8DC",
                "borderRadius": "6px",
                "padding": "12px",
                "gap": "4px",
                "backgroundColor": "#FAFAFA"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "labelCount"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "fontSize": "12px",
                    "color": "#666",
                    "textTransform": "uppercase"
                  },
                  "text": "Failover Count"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "valueCount"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "tagPath": "[default]GCS_RTAC_Control/FailoverCount"
                      },
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "22px",
                    "fontWeight": "bold",
                    "color": "#222"
                  }
                },
                "type": "ia.display.label"
              }
            ]
          },
          {
            "meta": {
              "name": "auditTime"
            },
            "position": {
              "grow": 2
            },
            "props": {
              "direction": "column",
              "style": {
                "borderStyle": "solid",
                "borderWidth": "1px",
                "borderColor": "#CFD8DC",
                "borderRadius": "6px",
                "padding": "12px",
                "gap": "4px",
                "backgroundColor": "#FAFAFA"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "labelTime"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "fontSize": "12px",
                    "color": "#666",
                    "textTransform": "uppercase"
                  },
                  "text": "Last Failover"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "valueTime"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "tagPath": "[default]GCS_RTAC_Control/LastFailoverTime"
                      },
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "16px",
                    "color": "#222"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "valueReason"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "tagPath": "[default]GCS_RTAC_Control/LastFailoverReason"
                      },
                      "type": "tag"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "13px",
                    "color": "#555",
                    "fontStyle": "italic"
                  }
                },
                "type": "ia.display.label"
              }
            ]
          }
        ]
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "20px",
        "backgroundColor": "#FFFFFF"
      }
    },
    "type": "ia.container.flex"
  }
}
